<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_maritime" model="ir.ui.view">
        <field name="name">purchase.order.form.maritime</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="port_call_id" readonly="state in ('purchase', 'done', 'cancel')"/>
                <field name="is_maritime_procurement" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="maintenance_request_id" optional="show"
                       readonly="state in ('purchase', 'done', 'cancel')"/>
                <field name="vessel_id" optional="show" readonly="1"/>
                <field name="port_call_id" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_list_maritime" model="ir.ui.view">
        <field name="name">purchase.order.list.maritime</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="port_call_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maritime_port_view_list" model="ir.ui.view">
        <field name="name">maritime.port.list</field>
        <field name="model">maritime.port</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="maritime_port_view_form" model="ir.ui.view">
        <field name="name">maritime.port.form</field>
        <field name="model">maritime.port</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="city"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group>
                            <field name="country_id"/>
                            <field name="timezone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="maritime_port_action" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">maritime.port</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

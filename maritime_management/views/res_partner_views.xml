<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_maritime" model="ir.ui.view">
        <field name="name">res.partner.form.maritime</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Maritime" name="maritime">
                    <group>
                        <field name="maritime_role"/>
                        <field name="maritime_port_ids" widget="many2many_tags"
                               invisible="maritime_role == 'none'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

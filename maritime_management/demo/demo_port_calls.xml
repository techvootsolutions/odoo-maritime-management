<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ACTIVE — Hong Kong (live operations demo) -->
    <record id="port_call_alpha_mumbai" model="port.call">
        <field name="vessel_id" ref="vessel_alpha"/>
        <field name="port_id" ref="port_hong_kong"/>
        <field name="agent_id" ref="partner_agent_mumbai"/>
        <field name="eta" eval="(DateTime.now() + relativedelta(days=-1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="etd" eval="(DateTime.now() + relativedelta(days=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="state">planned</field>
        <field name="note"><![CDATA[<p><b>ACTIVE DEMO</b> — Alpha at Hong Kong. Agent consolidating spares for 2 maintenance jobs.</p>]]></field>
    </record>
    <record id="port_call_beta_mumbai" model="port.call">
        <field name="vessel_id" ref="vessel_beta"/>
        <field name="port_id" ref="port_hong_kong"/>
        <field name="agent_id" ref="partner_agent_mumbai"/>
        <field name="eta" eval="(DateTime.now() + relativedelta(days=-1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="etd" eval="(DateTime.now() + relativedelta(hours=30)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="state">planned</field>
        <field name="note"><![CDATA[<p><b>ACTIVE DEMO</b> — Beta at Hong Kong. Same agent, different vessel — multi-ship consolidation.</p>]]></field>
    </record>


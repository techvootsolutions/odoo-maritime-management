<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_maritime" model="ir.module.category">
        <field name="name">Maritime Ship Management</field>
        <field name="sequence">35</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_maritime">
        <field name="name">Ship Management</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_maritime"/>
    </record>

    <record id="group_maritime_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_maritime"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_maritime_superintendent" model="res.groups">
        <field name="name">Technical Superintendent</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_maritime"/>
        <field name="implied_ids" eval="[(4, ref('group_maritime_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_maritime_finance" model="res.groups">
        <field name="name">Maritime Finance</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_maritime"/>
        <field name="implied_ids" eval="[(4, ref('group_maritime_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_maritime_agent" model="res.groups">
        <field name="name">Port Agent</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_maritime"/>
        <field name="implied_ids" eval="[(4, ref('group_maritime_user'))]"/>
    </record>

    <!-- The maintenance app limits regular users to followed equipment/requests;
         ship management users work on the whole fleet (company rules still apply). -->
    <record id="maritime_equipment_rule_user" model="ir.rule">
        <field name="name">Maritime: fleet vessels and machinery</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maritime_user'))]"/>
    </record>

    <record id="maritime_request_rule_user" model="ir.rule">
        <field name="name">Maritime: fleet maintenance requests</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_maritime_user'))]"/>
    </record>
</odoo>

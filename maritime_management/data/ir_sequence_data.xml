<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_port_call" model="ir.sequence">
        <field name="name">Port Call</field>
        <field name="code">port.call</field>
        <field name="prefix">PC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_port_disbursement" model="ir.sequence">
        <field name="name">Port Disbursement Account</field>
        <field name="code">port.disbursement.account</field>
        <field name="prefix">DA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

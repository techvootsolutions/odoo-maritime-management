<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="partner_demo_superintendent" model="res.partner">
        <field name="name">Demo Superintendent</field>
        <field name="email">superintendent@seatribute.demo</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="partner_demo_finance" model="res.partner">
        <field name="name">Demo Finance</field>
        <field name="email">finance@seatribute.demo</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="user_demo_superintendent" model="res.users">
        <field name="name">Demo Superintendent</field>
        <field name="login">superintendent@seatribute.demo</field>
        <field name="email">superintendent@seatribute.demo</field>
        <field name="partner_id" ref="partner_demo_superintendent"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="group_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('group_maritime_user')),
            (4, ref('group_maritime_superintendent')),
            (4, ref('maintenance.group_equipment_manager')),
        ]"/>
    </record>

    <record id="user_demo_finance" model="res.users">
        <field name="name">Demo Finance</field>
        <field name="login">finance@seatribute.demo</field>
        <field name="email">finance@seatribute.demo</field>
        <field name="partner_id" ref="partner_demo_finance"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="group_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('group_maritime_user')),
            (4, ref('group_maritime_finance')),
            (4, ref('account.group_account_user')),
        ]"/>
    </record>
</odoo>
